POSTGRES_PASSWORD=replace-with-a-long-random-password
# URL-encode password characters in this URL. Host is postgres, never localhost.
DATABASE_URL=postgres://exam_user:replace-with-a-long-random-password@postgres:5432/secure_exam
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret
CORS_ORIGIN=https://exam.college.local,app://exam
REQUIRE_DESKTOP_CLIENT=true
EXAM_ALLOWED_CIDRS=10.20.0.0/16
CODING_GRADING_MODE=DEFERRED
CODING_SERVER_RUN=false
RUNNER_PYTHON_IMAGE=python:3.12-slim
# Configure TLS credentials or SSH credentials as read-only mounts for your runner.
# Never expose an unauthenticated Docker TCP daemon.
DOCKER_HOST=ssh://runner@runner.college.local
