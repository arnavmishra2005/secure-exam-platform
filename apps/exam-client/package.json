{
  "name": "@secure-exam/exam-client-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "desktop:dev": "npm run compile && concurrently -k \"npm run dev --workspace=@secure-exam/web\" \"wait-on http://localhost:3003 && env -u ELECTRON_RUN_AS_NODE electron .\"",
    "desktop:dev:windows": "npm run compile && concurrently -k \"npm run dev --workspace=@secure-exam/web\" \"wait-on http://localhost:3003 && npm run desktop:start:windows\"",
    "desktop:build": "tsc -p tsconfig.json && npm run build --workspace=@secure-exam/web && electron-builder --linux",
    "desktop:build:windows": "tsc -p tsconfig.json && npm run build --workspace=@secure-exam/web && electron-builder --win nsis",
    "desktop:start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "desktop:start:windows": "node scripts/start-electron.mjs",
    "compile": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test test/*.test.mjs"
  },
  "build": {
    "appId": "dev.secure-exam.client",
    "productName": "SecureExam",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/main/**/*",
      "dist/preload/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "maintainer": "secure-exam",
      "mimeTypes": [
        "x-scheme-handler/secure-exam"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "include": "build/installer.nsh"
    },
    "extraMetadata": {
      "main": "dist/main/main.js"
    },
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      }
    ],
    "protocols": [
      {
        "name": "Secure Exam",
        "schemes": [
          "secure-exam"
        ]
      }
    ]
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "44.9.3",
    "electron-builder": "^24.13.3",
    "typescript": "^5.4.5",
    "wait-on": "^7.2.0"
  }
}
