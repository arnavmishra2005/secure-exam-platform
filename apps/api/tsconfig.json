{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "incremental": false,
    "sourceMap": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": false,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true
  },
  "references": [
    { "path": "../../packages/types" },
    { "path": "../../packages/validation" }
  ],
  "include": ["src/**/*.ts"]
}
