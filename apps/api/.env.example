NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://exam_user:exam_pass@localhost:5432/secure_exam

JWT_ACCESS_SECRET=change-me-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3001,http://localhost:3002,http://localhost:3003

THROTTLE_TTL=60
THROTTLE_LIMIT=1000

# ---- Phase 4 ----------------------------------------------------------------
# Prefixes keep each owner's settings apart: RUNNER_* (Person B), SMTP_*
# (email, deferred), DESKTOP_* (Person C). All are optional until used.

# Person C — monitoring: seconds without a heartbeat before an attempt shows as disconnected.
HEARTBEAT_DISCONNECT_SECONDS=45

# Person B — code runner (Docker-per-run). Run on a dedicated Linux Docker host.
# RUNNER_PYTHON_IMAGE=python:3.12-slim
# RUNNER_MAX_CONCURRENCY=4
# RUNNER_TIMEOUT_MS=5000
# RUNNER_DOCKER_HOST=unix:///var/run/docker.sock

# Email notifications — deferred; in-app notifications only for now.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=exams@example.edu

# Person C — desktop (Electron) client.
# DESKTOP_MIN_CLIENT_VERSION=1.0.0
