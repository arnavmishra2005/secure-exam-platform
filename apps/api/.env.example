NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://exam_user:exam_pass@localhost:5432/secure_exam

JWT_ACCESS_SECRET=change-me-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3001,http://localhost:3002

THROTTLE_TTL=60
THROTTLE_LIMIT=1000

# Person B: sandboxed code runner. Pin the image by digest in production,
# e.g. python:3.12-slim@sha256:<digest>.
RUNNER_DOCKER_BIN=docker
RUNNER_PYTHON_IMAGE=python:3.12-slim
RUNNER_MAX_CONCURRENCY=4
RUNNER_OUTPUT_LIMIT_BYTES=65536
RUNNER_STARTUP_TIMEOUT_MS=10000
