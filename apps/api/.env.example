NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://exam_user:exam_pass@localhost:5432/secure_exam

JWT_ACCESS_SECRET=change-me-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3001,http://localhost:3002,http://localhost:3003,app://exam

THROTTLE_TTL=60
THROTTLE_LIMIT=1000

# Person B: sandboxed code runner. Pin the image by digest in production,
# e.g. python:3.12-slim@sha256:<digest>.
RUNNER_DOCKER_BIN=docker
RUNNER_PYTHON_IMAGE=python:3.12-slim
RUNNER_MAX_CONCURRENCY=4
RUNNER_MAX_QUEUE=100
RUNNER_RUNS_PER_MINUTE=20
RUNNER_OUTPUT_LIMIT_BYTES=65536
RUNNER_STARTUP_TIMEOUT_MS=10000

# Person B: execution modes (see "Decision log" in person_b_plan.md).
# DEFERRED = Submit only saves the code; all tests run here after the attempt ends.
# LIVE     = Submit runs all tests immediately and shows the score.
CODING_GRADING_MODE=DEFERRED
# Run / Run samples normally execute on the student's PC (exam app). Allow them
# here too? Leave unset for: on in development, off in production.
# CODING_SERVER_RUN=true

# Person C — monitoring: seconds without a heartbeat before an attempt shows as disconnected.
HEARTBEAT_DISCONNECT_SECONDS=45

# Email notifications — deferred; in-app notifications only for now.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=exams@example.edu

# Person C — desktop (Electron) client.
# DESKTOP_MIN_CLIENT_VERSION=1.0.0

# Exams (start, questions, answers, submit) can only be taken in the Secure Exam app.
# Set to false to sit an exam in a normal browser while developing.
REQUIRE_DESKTOP_CLIENT=true
# Violations at which an attempt shows as flagged on the monitoring screen.
VIOLATION_FLAG_THRESHOLD=5
