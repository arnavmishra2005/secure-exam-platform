# Base URL of the API (apps/api). Inlined at build time by Vite.
VITE_API_BASE_URL=http://localhost:3000

# Exam client: how often a running attempt sends a heartbeat (ms). The
# heartbeat carries the server clock and the attempt's current expiry, so a
# time extension reaches the student within one interval.
VITE_HEARTBEAT_INTERVAL_MS=15000

# Exams are taken in the Secure Exam app (the API enforces the same rule with
# REQUIRE_DESKTOP_CLIENT). Set both to false to sit an exam in a browser while developing.
VITE_REQUIRE_DESKTOP_EXAM=true
