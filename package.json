{
  "name": "secure-exam",
  "private": true,
  "workspaces": [
    "apps/*",
    "apps/exam-client/renderer",
    "packages/*"
  ],
  "scripts": {
    "api:start": "npm run start:dev --workspace=apps/api",
    "api:build": "npm run build --workspace=apps/api",
    "api:lint": "npm run lint --workspace=apps/api",
    "api:test": "npm run test --workspace=apps/api",
    "admin:dev": "npm run dev --workspace=apps/admin-web",
    "admin:build": "npm run build --workspace=apps/admin-web",
    "admin:lint": "npm run lint --workspace=apps/admin-web",
    "client:dev": "npm run dev --workspace=@secure-exam/exam-client-renderer",
    "client:build": "npm run build --workspace=@secure-exam/exam-client-renderer",
    "migration:run": "npm run migration:run --workspace=apps/api",
    "migration:revert": "npm run migration:revert --workspace=apps/api",
    "typecheck": "npm run build --workspace=packages/types && npm run build --workspace=packages/validation && npm run build --workspace=packages/api-client"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
